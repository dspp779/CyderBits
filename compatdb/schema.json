{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyder.invalid/schemas/compatdb-authoring-v1.json",
  "title": "Cyder CompatDB authoring schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rules"],
  "properties": {
    "schema_version": {"const": 1},
    "rules": {
      "type": "array",
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/rule"}
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "description", "priority", "enabled", "stability",
        "applies_to", "match", "actions", "tests"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "description": {"type": "string", "minLength": 1, "maxLength": 1024},
        "priority": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "enabled": {"type": "boolean"},
        "stability": {"enum": ["stable", "experimental"]},
        "applies_to": {"$ref": "#/$defs/appliesTo"},
        "match": {"$ref": "#/$defs/match"},
        "actions": {"$ref": "#/$defs/actions"},
        "tests": {"$ref": "#/$defs/tests"}
      }
    },
    "appliesTo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "engine_api"],
      "properties": {
        "platform": {"const": "macos"},
        "engine_api": {"const": 1}
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable"],
      "properties": {
        "executable": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path_suffix"],
          "properties": {
            "path_suffix": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^\\\\[\\x20-\\x7e]+$"
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^\\\\[\\x20-\\x7e]+$"
                  }
                }
              ]
            }
          }
        },
        "command_line": {
          "type": "object",
          "additionalProperties": false,
          "required": ["excludes"],
          "properties": {
            "excludes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["token"],
                "properties": {"token": {"type": "string"}}
              }
            }
          }
        }
      }
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "allOf": [
        {
          "if": {"required": ["replace_executable"]},
          "then": {"maxProperties": 1}
        }
      ],
      "properties": {
        "append_args": {
          "type": "object",
          "additionalProperties": false,
          "required": ["args", "deduplicate"],
          "properties": {
            "args": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {"type": "string"}
            },
            "deduplicate": {"const": "option"}
          }
        },
        "dll_overrides": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 64,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}(?:\\.dll)?$"
          },
          "additionalProperties": {
            "enum": [
              "native,builtin",
              "builtin,native",
              "native",
              "builtin",
              "disabled"
            ]
          }
        },
        "set_env": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 64,
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "unset_env": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
          }
        },
        "graphics_backend": {
          "enum": ["default", "wined3d", "dxvk", "dxmt", "d3dmetal"]
        },
        "wined3d_renderer": {
          "enum": ["auto", "opengl", "gdi", "vulkan"]
        },
        "replace_executable": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path_suffix"],
          "properties": {
            "path_suffix": {
              "type": "string",
              "pattern": "^\\\\[\\x20-\\x7e]+\\.exe$"
            }
          }
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matches", "excludes"],
      "properties": {
        "matches": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/fixture"}
        },
        "excludes": {
          "type": "array",
          "items": {"$ref": "#/$defs/fixture"}
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "executable", "command_line"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "executable": {"type": "string"},
        "command_line": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        }
      }
    }
  }
}
