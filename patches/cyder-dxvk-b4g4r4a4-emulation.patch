--- a/src/d3d11/d3d11_b4g4r4a4.h
+++ b/src/d3d11/d3d11_b4g4r4a4.h
@@ -0,0 +1,122 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace dxvk {
+
+  /**
+   * \brief Cyder: B4G4R4A4 emulation helpers
+   *
+   * Metal on non-Apple GPUs has no 4-bit-per-channel formats, so
+   * DXGI_FORMAT_B4G4R4A4_UNORM is stored as VK_FORMAT_B8G8R8A8_UNORM
+   * and converted wherever the application reads or writes texels.
+   * Both layouts share the B, G, R, A channel order from low to high.
+   */
+  inline uint32_t ExpandB4G4R4A4(uint16_t texel) {
+    uint32_t b = (texel >>  0) & 0xf;
+    uint32_t g = (texel >>  4) & 0xf;
+    uint32_t r = (texel >>  8) & 0xf;
+    uint32_t a = (texel >> 12) & 0xf;
+    return (b * 17) | ((g * 17) << 8) | ((r * 17) << 16) | ((a * 17) << 24);
+  }
+
+
+  inline uint16_t PackB4G4R4A4(uint32_t texel) {
+    auto q = [] (uint32_t c) { return ((c & 0xff) + 8) / 17; };
+    return uint16_t(q(texel) | (q(texel >> 8) << 4)
+      | (q(texel >> 16) << 8) | (q(texel >> 24) << 12));
+  }
+
+
+  /**
+   * \brief Converts B4G4R4A4 rows to B8G8R8A8 rows in a separate buffer
+   */
+  inline void ConvertB4G4R4A4ToB8G8R8A8(
+          void*           pDst,
+          size_t          DstRowPitch,
+          size_t          DstSlicePitch,
+    const void*           pSrc,
+          size_t          SrcRowPitch,
+          size_t          SrcSlicePitch,
+          uint32_t        Width,
+          uint32_t        Height,
+          uint32_t        Depth) {
+    if (!SrcRowPitch)
+      SrcRowPitch = size_t(Width) * 2;
+    if (!SrcSlicePitch)
+      SrcSlicePitch = SrcRowPitch * Height;
+
+    for (uint32_t z = 0; z < Depth; z++) {
+      for (uint32_t y = 0; y < Height; y++) {
+        auto src = reinterpret_cast<const char*>(pSrc) + z * SrcSlicePitch + y * SrcRowPitch;
+        auto dst = reinterpret_cast<char*>(pDst) + z * DstSlicePitch + y * DstRowPitch;
+
+        for (uint32_t x = 0; x < Width; x++) {
+          uint16_t texel;
+          std::memcpy(&texel, src + 2 * x, sizeof(texel));
+          uint32_t expanded = ExpandB4G4R4A4(texel);
+          std::memcpy(dst + 4 * x, &expanded, sizeof(expanded));
+        }
+      }
+    }
+  }
+
+
+  /**
+   * \brief Expands B4G4R4A4 texels to B8G8R8A8 in place
+   *
+   * Each row must be at least 4 * Width bytes. Rows are processed
+   * from the last texel backwards so no source texel is overwritten
+   * before it has been read.
+   */
+  inline void ExpandB4G4R4A4InPlace(
+          void*           pData,
+          size_t          RowPitch,
+          size_t          SlicePitch,
+          uint32_t        Width,
+          uint32_t        Height,
+          uint32_t        Depth) {
+    for (uint32_t z = 0; z < Depth; z++) {
+      for (uint32_t y = 0; y < Height; y++) {
+        auto row = reinterpret_cast<char*>(pData) + z * SlicePitch + y * RowPitch;
+
+        for (uint32_t x = Width; x-- > 0; ) {
+          uint16_t texel;
+          std::memcpy(&texel, row + 2 * x, sizeof(texel));
+          uint32_t expanded = ExpandB4G4R4A4(texel);
+          std::memcpy(row + 4 * x, &expanded, sizeof(expanded));
+        }
+      }
+    }
+  }
+
+
+  /**
+   * \brief Packs B8G8R8A8 texels to B4G4R4A4 in place
+   *
+   * Inverse of \ref ExpandB4G4R4A4InPlace, processed front to back.
+   */
+  inline void PackB4G4R4A4InPlace(
+          void*           pData,
+          size_t          RowPitch,
+          size_t          SlicePitch,
+          uint32_t        Width,
+          uint32_t        Height,
+          uint32_t        Depth) {
+    for (uint32_t z = 0; z < Depth; z++) {
+      for (uint32_t y = 0; y < Height; y++) {
+        auto row = reinterpret_cast<char*>(pData) + z * SlicePitch + y * RowPitch;
+
+        for (uint32_t x = 0; x < Width; x++) {
+          uint32_t texel;
+          std::memcpy(&texel, row + 4 * x, sizeof(texel));
+          uint16_t packed = PackB4G4R4A4(texel);
+          std::memcpy(row + 2 * x, &packed, sizeof(packed));
+        }
+      }
+    }
+  }
+
+}
