+      const uint32_t mipLevels = pTexture->Desc()->MipLevels;
+      const uint32_t count     = pTexture->CountSubresources();
+
+      convertedData.resize(count);
+      convertedStorage.resize(count);
+
+      for (uint32_t i = 0; i < count; i++) {
+        VkExtent3D extent = pTexture->MipLevelExtent(i % mipLevels);
+        size_t rowPitch   = size_t(extent.width) * 4;
+        size_t slicePitch = rowPitch * extent.height;
