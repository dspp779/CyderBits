+#define CYDER_CDB_HEADER_SIZE       40
+#define CYDER_CDB_MAX_FILE_SIZE     (4 * 1024 * 1024)
+#define CYDER_CDB_MAX_RULES         4096
+#define CYDER_CDB_MAX_RECORDS       65536
+#define CYDER_CDB_MAX_PAYLOAD       65536
+#define CYDER_CDB_MAX_STRING        4096
+#define CYDER_CDB_MAX_RULE_MATCHES  64
+#define CYDER_CDB_MAX_RULE_ACTIONS  64
+#define CYDER_CDB_MAX_APPLIED_KEYS  256
+#define CYDER_CDB_MAX_ENV_CHARS     (1024 * 1024)
+
+#define CYDER_CDB_RECORD_REQUIRED   0x0001
+
+enum cyder_cdb_record_type
+{
+    CYDER_CDB_RULE_BEGIN          = 0x0001,
+    CYDER_CDB_RULE_END            = 0x0002,
+    CYDER_CDB_RULE_ID             = 0x0010,
+    CYDER_CDB_PRIORITY            = 0x0011,
+    CYDER_CDB_ENABLED             = 0x0012,
+    CYDER_CDB_MATCH_PATH_SUFFIX   = 0x0020,
+    CYDER_CDB_MATCH_FORBIDDEN_ARG = 0x0021,
+    CYDER_CDB_ACTION_APPEND_ARG   = 0x0030,
+    CYDER_CDB_ACTION_DLL_OVERRIDE = 0x0031,
+    CYDER_CDB_ACTION_SET_ENV      = 0x0032,
+    CYDER_CDB_ACTION_UNSET_ENV    = 0x0033,
+    CYDER_CDB_ACTION_GRAPHICS_BACKEND = 0x0034,
+    CYDER_CDB_ACTION_REPLACE_EXECUTABLE = 0x0035,
+    CYDER_CDB_ACTION_WINED3D_RENDERER = 0x0036
+};
+
+struct cyder_cdb
+{
+    unsigned char *data;
+    size_t size;
+    uint32_t record_count;
+    uint32_t rule_count;
+};
+
+struct cyder_slice
+{
+    const unsigned char *data;
+    uint32_t size;
+};
+
+struct cyder_rule
+{
+    struct cyder_slice id;
+    struct cyder_slice paths[CYDER_CDB_MAX_RULE_MATCHES];
+    struct cyder_slice forbidden[CYDER_CDB_MAX_RULE_MATCHES];
+    struct cyder_slice actions[CYDER_CDB_MAX_RULE_ACTIONS];
+    struct cyder_slice dll_overrides[CYDER_CDB_MAX_RULE_ACTIONS];
+    struct cyder_slice set_env[CYDER_CDB_MAX_RULE_ACTIONS];
+    struct cyder_slice unset_env[CYDER_CDB_MAX_RULE_ACTIONS];
+    struct cyder_slice graphics_backend;
+    struct cyder_slice wined3d_renderer;
+    struct cyder_slice replacement;
+    unsigned int path_count;
+    unsigned int forbidden_count;
+    unsigned int action_count;
+    unsigned int dll_override_count;
+    unsigned int set_env_count;
+    unsigned int unset_env_count;
+    int32_t priority;
+    BOOL have_id;
+    BOOL have_priority;
+    BOOL have_enabled;
+    BOOL have_graphics_backend;
+    BOOL have_wined3d_renderer;
+    BOOL have_replacement;
+    BOOL enabled;
+    BOOL invalid;
+};
+
+struct cyder_applied_state
+{
+    struct cyder_slice env_names[CYDER_CDB_MAX_APPLIED_KEYS];
+    struct cyder_slice dll_names[CYDER_CDB_MAX_APPLIED_KEYS];
+    unsigned int env_name_count;
+    unsigned int dll_name_count;
+    BOOL graphics_backend;
+    BOOL wined3d_renderer;
+    BOOL replacement;
+};
+
+static BOOL valid_utf8_string( const struct cyder_slice *slice );
+
+static uint16_t read_u16( const unsigned char *ptr )
+{
+    return ptr[0] | ((uint16_t)ptr[1] << 8);
+}
+
+static uint32_t read_u32( const unsigned char *ptr )
+{
+    return ptr[0] | ((uint32_t)ptr[1] << 8) | ((uint32_t)ptr[2] << 16) |
+           ((uint32_t)ptr[3] << 24);
+}
+
+static uint64_t read_u64( const unsigned char *ptr )
+{
+    return read_u32( ptr ) | ((uint64_t)read_u32( ptr + 4 ) << 32);
+}
+
+static BOOL read_all( int fd, void *buffer, size_t size )
+{
+    unsigned char *ptr = buffer;
+
+    while (size)
+    {
+        ssize_t ret = read( fd, ptr, size );
+        if (ret > 0)
+        {
+            ptr += ret;
+            size -= ret;
+        }
+        else if (!ret) return FALSE;
+        else if (errno != EINTR) return FALSE;
+    }
+    return TRUE;
+}
+
+static BOOL load_cdb( const char *path, struct cyder_cdb *db )
+{
+    static const unsigned char magic[8] = {'C','Y','D','R','C','D','B',0};
+    struct stat st;
+    unsigned char *data = NULL;
+    uint64_t declared_size;
+    int fd = -1;
+
+    memset( db, 0, sizeof(*db) );
+    if (!path || !path[0]) return FALSE;
+    if ((fd = open( path, O_RDONLY )) == -1) return FALSE;
+    if (fstat( fd, &st ) == -1 || !S_ISREG( st.st_mode ) ||
+        st.st_size < CYDER_CDB_HEADER_SIZE || st.st_size > CYDER_CDB_MAX_FILE_SIZE)
+        goto failed;
+    if (!(data = malloc( st.st_size ))) goto failed;
+    if (!read_all( fd, data, st.st_size )) goto failed;
+    close( fd );
+    fd = -1;
+
+    declared_size = read_u64( data + 16 );
+    if (memcmp( data, magic, sizeof(magic) ) ||
+        read_u16( data + 8 ) != 1 ||
+        read_u16( data + 10 ) != CYDER_CDB_HEADER_SIZE ||
+        read_u32( data + 12 ) ||
+        declared_size != (uint64_t)st.st_size ||
+        read_u32( data + 24 ) > CYDER_CDB_MAX_RECORDS ||
+        read_u32( data + 28 ) > CYDER_CDB_MAX_RULES ||
+        read_u32( data + 32 ) != CYDER_CDB_HEADER_SIZE ||
+        read_u32( data + 36 ))
+        goto failed;
+
+    db->data = data;
+    db->size = st.st_size;
+    db->record_count = read_u32( data + 24 );
+    db->rule_count = read_u32( data + 28 );
+    return TRUE;
+
+failed:
+    if (fd != -1) close( fd );
+    free( data );
+    return FALSE;
+}
+
+static void free_cdb( struct cyder_cdb *db )
+{
+    free( db->data );
+    memset( db, 0, sizeof(*db) );
+}
+
+/* Validate all file-wide structure before any rule can affect a command line. */
+static BOOL validate_cdb_structure( const struct cyder_cdb *db )
+{
+    size_t offset = CYDER_CDB_HEADER_SIZE;
+    uint32_t i, observed_rules = 0;
+    BOOL in_rule = FALSE;
+
+    for (i = 0; i < db->record_count; ++i)
+    {
+        uint16_t type;
+        uint32_t payload_size;
+
+        if (offset > db->size || db->size - offset < 8) return FALSE;
+        type = read_u16( db->data + offset );
+        payload_size = read_u32( db->data + offset + 4 );
+        offset += 8;
+        if (payload_size > CYDER_CDB_MAX_PAYLOAD ||
+            offset > db->size || payload_size > db->size - offset)
+            return FALSE;
+
+        if (type == CYDER_CDB_RULE_BEGIN)
+        {
+            if (in_rule || payload_size) return FALSE;
+            in_rule = TRUE;
+        }
+        else if (type == CYDER_CDB_RULE_END)
+        {
+            if (!in_rule || payload_size) return FALSE;
+            in_rule = FALSE;
+            ++observed_rules;
+        }
+        else if (!in_rule) return FALSE;
+
+        offset += payload_size;
+    }
+
+    return !in_rule && offset == db->size && observed_rules == db->rule_count;
+}
+
+/*
+ * Rule IDs are a database-wide key. Validate uniqueness before the second
+ * pass can apply any action, so a duplicate near EOF cannot leave earlier
+ * command-line changes in place.
+ */
+static BOOL validate_unique_rule_ids( const struct cyder_cdb *db )
+{
+    struct cyder_slice *ids, current = {0};
+    size_t offset = CYDER_CDB_HEADER_SIZE;
+    uint32_t i, id_count = 0, current_count = 0;
+    BOOL ret = FALSE;
+
+    if (!db->rule_count) return TRUE;
+    if (!(ids = calloc( db->rule_count, sizeof(*ids) ))) return FALSE;
+
+    for (i = 0; i < db->record_count; ++i)
+    {
+        uint16_t type = read_u16( db->data + offset );
+        uint16_t flags = read_u16( db->data + offset + 2 );
+        uint32_t size = read_u32( db->data + offset + 4 );
+        struct cyder_slice slice;
+
+        offset += 8;
+        slice.data = db->data + offset;
+        slice.size = size;
+        offset += size;
+
+        if (type == CYDER_CDB_RULE_BEGIN)
+        {
+            memset( &current, 0, sizeof(current) );
+            current_count = 0;
+        }
+        else if (type == CYDER_CDB_RULE_ID)
+        {
+            ++current_count;
+            if (current_count == 1 && flags == CYDER_CDB_RECORD_REQUIRED &&
+                valid_utf8_string( &slice ))
+                current = slice;
+        }
+        else if (type == CYDER_CDB_RULE_END && current_count == 1 && current.data)
+        {
+            uint32_t j;
+            for (j = 0; j < id_count; ++j)
+                if (ids[j].size == current.size &&
+                    !memcmp( ids[j].data, current.data, current.size ))
+                {
+                    WARN( "ignoring database with duplicate rule ID %s\n",
+                          debugstr_an( (const char *)current.data, current.size ) );
+                    goto done;
+                }
+            ids[id_count++] = current;
+        }
+    }
+    ret = TRUE;
+
+done:
+    free( ids );
+    return ret;
+}
+
+static BOOL valid_utf8_string( const struct cyder_slice *slice )
+{
+    DWORD size;
+    NTSTATUS status;
+
+    if (!slice->size || slice->size > CYDER_CDB_MAX_STRING ||
+        memchr( slice->data, 0, slice->size ))
+        return FALSE;
+    status = RtlUTF8ToUnicodeN( NULL, 0, &size, (const char *)slice->data, slice->size );
+    return !status && size && !(size % sizeof(WCHAR));
+}
+
+static BOOL valid_path_suffix( const struct cyder_slice *slice )
+{
+    uint32_t i;
+
+    if (!valid_utf8_string( slice ) || slice->data[0] != '\\') return FALSE;
+    for (i = 0; i < slice->size; ++i)
+    {
+        unsigned char ch = slice->data[i];
+        if (ch < 0x20 || ch > 0x7e || ch == '/' || (ch >= 'A' && ch <= 'Z'))
+            return FALSE;
+    }
+    return TRUE;
+}
+
+static BOOL valid_dll_override( const struct cyder_slice *slice )
+{
+    const unsigned char *equals;
+    uint32_t i, order_size;
+
+    if (!valid_utf8_string( slice ) ||
+        !(equals = memchr( slice->data, '=', slice->size )) ||
+        equals == slice->data)
+        return FALSE;
+    for (i = 0; i < equals - slice->data; ++i)
+    {
+        unsigned char ch = slice->data[i];
+        if (!((ch >= 'a' && ch <= 'z') || (ch >= '0' && ch <= '9') ||
+              ch == '_' || ch == '-'))
+            return FALSE;
+    }
+    order_size = slice->size - (equals - slice->data) - 1;
+    if (!order_size) return TRUE;
+    if (order_size == 1 && (equals[1] == 'n' || equals[1] == 'b')) return TRUE;
+    return order_size == 3 &&
+           ((equals[1] == 'n' && equals[2] == ',' && equals[3] == 'b') ||
+            (equals[1] == 'b' && equals[2] == ',' && equals[3] == 'n'));
+}
+
+static BOOL ascii_equal_nocase( const unsigned char *left, uint32_t left_size,
+                                const unsigned char *right, uint32_t right_size )
+{
+    uint32_t i;
+
+    if (left_size != right_size) return FALSE;
+    for (i = 0; i < left_size; ++i)
+    {
+        unsigned char a = left[i], b = right[i];
+        if (a >= 'a' && a <= 'z') a -= 'a' - 'A';
+        if (b >= 'a' && b <= 'z') b -= 'a' - 'A';
+        if (a != b) return FALSE;
+    }
+    return TRUE;
+}
+
+static BOOL valid_env_name_bytes( const unsigned char *data, uint32_t size )
+{
+    static const char *forbidden[] =
+    {
+        "HOME", "PATH", "WINEPREFIX", "WINELOADER", "WINESERVER",
+        "CYDER_COMPATDB", "CYDER_COMPATDB_PATH"
+    };
+    uint32_t i;
+
+    if (!size || size > 128 ||
+        !((data[0] >= 'A' && data[0] <= 'Z') || data[0] == '_'))
+        return FALSE;
+    for (i = 1; i < size; ++i)
+        if (!((data[i] >= 'A' && data[i] <= 'Z') ||
+              (data[i] >= '0' && data[i] <= '9') || data[i] == '_'))
+            return FALSE;
+    if ((size >= 5 && !memcmp( data, "DYLD_", 5 )) ||
+        (size >= 3 && !memcmp( data, "LD_", 3 )) ||
+        (size >= 6 && !memcmp( data, "CYDER_", 6 )))
+        return FALSE;
+    for (i = 0; i < ARRAY_SIZE(forbidden); ++i)
+        if (strlen( forbidden[i] ) == size && !memcmp( data, forbidden[i], size ))
+            return FALSE;
+    return TRUE;
+}
+
+static BOOL valid_set_env( const struct cyder_slice *slice )
+{
+    const unsigned char *equals;
+    uint32_t i;
+
+    if (!valid_utf8_string( slice ) ||
+        !(equals = memchr( slice->data, '=', slice->size )) ||
+        !valid_env_name_bytes( slice->data, equals - slice->data ))
+        return FALSE;
+    for (i = equals - slice->data + 1; i < slice->size; ++i)
+        if (slice->data[i] == '\r' || slice->data[i] == '\n') return FALSE;
+    return TRUE;
+}
+
+static BOOL valid_unset_env( const struct cyder_slice *slice )
+{
+    return valid_utf8_string( slice ) &&
+           valid_env_name_bytes( slice->data, slice->size );
+}
+
+static BOOL valid_graphics_backend( const struct cyder_slice *slice )
+{
+    return (slice->size == 7 && !memcmp( slice->data, "default", 7 )) ||
+           (slice->size == 7 && !memcmp( slice->data, "wined3d", 7 )) ||
+           (slice->size == 4 && !memcmp( slice->data, "dxvk", 4 )) ||
+           (slice->size == 4 && !memcmp( slice->data, "dxmt", 4 )) ||
+           (slice->size == 8 && !memcmp( slice->data, "d3dmetal", 8 ));
+}
+
+static BOOL valid_wined3d_renderer( const struct cyder_slice *slice )
+{
+    return (slice->size == 4 && !memcmp( slice->data, "auto", 4 )) ||
+           (slice->size == 2 && !memcmp( slice->data, "gl", 2 )) ||
+           (slice->size == 3 && !memcmp( slice->data, "gdi", 3 )) ||
+           (slice->size == 6 && !memcmp( slice->data, "vulkan", 6 ));
+}
+
+static BOOL valid_replacement_suffix( const struct cyder_slice *slice )
+{
+    uint32_t i, component = 1;
+
+    if (!valid_path_suffix( slice ) || slice->size < 5 ||
+        memcmp( slice->data + slice->size - 4, ".exe", 4 ))
+        return FALSE;
+    for (i = 1; i <= slice->size; ++i)
+    {
+        if (i < slice->size && slice->data[i] == ':') return FALSE;
+        if (i == slice->size || slice->data[i] == '\\')
+        {
+            uint32_t length = i - component;
+            if (!length || (length == 1 && slice->data[component] == '.') ||
+                (length == 2 && slice->data[component] == '.' &&
+                 slice->data[component + 1] == '.'))
+                return FALSE;
+            component = i + 1;
+        }
+    }
+    return TRUE;
+}
+
+static int slice_key_status( struct cyder_slice *keys, unsigned int *count,
+                             const unsigned char *data, uint32_t size )
+{
+    unsigned int i;
+
+    for (i = 0; i < *count; ++i)
+        if (ascii_equal_nocase( keys[i].data, keys[i].size, data, size ))
+            return 1;
+    if (*count == CYDER_CDB_MAX_APPLIED_KEYS) return -1;
+    keys[*count].data = data;
+    keys[*count].size = size;
+    ++*count;
+    return 0;
+}
+
+static WCHAR *slice_to_wstr( const struct cyder_slice *slice, SIZE_T *length )
+{
+    DWORD bytes;
+    WCHAR *ret;
+
+    if (!valid_utf8_string( slice ) ||
+        RtlUTF8ToUnicodeN( NULL, 0, &bytes, (const char *)slice->data, slice->size ))
+        return NULL;
+    if (!(ret = malloc( bytes + sizeof(WCHAR) ))) return NULL;
+    if (RtlUTF8ToUnicodeN( ret, bytes, &bytes, (const char *)slice->data, slice->size ))
+    {
+        free( ret );
+        return NULL;
+    }
+    ret[bytes / sizeof(WCHAR)] = 0;
+    *length = bytes / sizeof(WCHAR);
+    return ret;
+}
+
+static BOOL path_has_suffix( const UNICODE_STRING *path, const struct cyder_slice *suffix,
+                             BOOL *matched )
+{
+    SIZE_T path_len = path->Length / sizeof(WCHAR), suffix_len, i;
+    WCHAR *suffixW;
+    BOOL ret = FALSE;
+
+    *matched = FALSE;
+    if (!(suffixW = slice_to_wstr( suffix, &suffix_len ))) return FALSE;
+    if (suffix_len <= path_len)
+    {
+        ret = TRUE;
+        for (i = 0; i < suffix_len; ++i)
+        {
+            WCHAR a = path->Buffer[path_len - suffix_len + i];
+            WCHAR b = suffixW[i];
+            if (a == '/') a = '\\';
+            if (b == '/') b = '\\';
+            if (towupper( a ) != towupper( b ))
+            {
+                ret = FALSE;
+                break;
+            }
+        }
+    }
+    free( suffixW );
+    *matched = ret;
+    return TRUE;
+}
+
+static SIZE_T argument_key_length( const WCHAR *arg, SIZE_T length )
+{
+    SIZE_T i;
+
+    if (!length || (arg[0] != '-' && arg[0] != '/')) return length;
+    for (i = 1; i < length; ++i)
+        if (arg[i] == '=') return i;
+    return length;
+}
+
+static BOOL argument_keys_equal( const WCHAR *left, SIZE_T left_len,
+                                 const WCHAR *right, SIZE_T right_len )
+{
+    BOOL left_option = left_len && (left[0] == '-' || left[0] == '/');
+    BOOL right_option = right_len && (right[0] == '-' || right[0] == '/');
+    SIZE_T i;
+
+    if (left_option != right_option) return FALSE;
+    left_len = argument_key_length( left, left_len );
+    right_len = argument_key_length( right, right_len );
+    if (left_len != right_len) return FALSE;
+    if (!left_option) return !memcmp( left, right, left_len * sizeof(WCHAR) );
+    for (i = 0; i < left_len; ++i)
+    {
+        WCHAR a = left[i], b = right[i];
+        if (a >= 'A' && a <= 'Z') a += 'a' - 'A';
+        if (b >= 'A' && b <= 'Z') b += 'a' - 'A';
+        if (a != b) return FALSE;
+    }
+    return TRUE;
+}
+
+/* Parse one Windows argv token, following the same backslash/quote rules as build_argv(). */
+static const WCHAR *parse_argument( const WCHAR *src, const WCHAR *end,
+                                    WCHAR *buffer, SIZE_T *length )
+{
+    WCHAR *dst = buffer;
+    BOOL in_quotes = FALSE;
+
+    while (src < end && (*src == ' ' || *src == '\t')) ++src;
+    while (src < end && (in_quotes || (*src != ' ' && *src != '\t')))
+    {
+        SIZE_T slashes = 0;
+
+        while (src < end && *src == '\\')
+        {
+            ++slashes;
+            ++src;
+        }
+        if (src < end && *src == '"')
+        {
+            SIZE_T i;
+            for (i = 0; i < slashes / 2; ++i) *dst++ = '\\';
+            if (slashes & 1)
+            {
+                *dst++ = '"';
+                ++src;
+            }
+            else
+            {
+                ++src;
+                if (in_quotes && src < end && *src == '"')
+                {
+                    *dst++ = '"';
+                    ++src;
+                }
+                else in_quotes = !in_quotes;
+            }
+        }
+        else
+        {
+            while (slashes--) *dst++ = '\\';
+            if (src < end && (in_quotes || (*src != ' ' && *src != '\t')))
+                *dst++ = *src++;
+        }
+    }
+    *length = dst - buffer;
+    while (src < end && (*src == ' ' || *src == '\t')) ++src;
+    return src;
+}
+
+static BOOL command_line_has_argument( const UNICODE_STRING *cmdline,
+                                       const WCHAR *wanted, SIZE_T wanted_len,
+                                       BOOL compare_key, BOOL *found )
+{
+    const WCHAR *src = cmdline->Buffer;
+    const WCHAR *end = src + cmdline->Length / sizeof(WCHAR);
+    WCHAR *arg;
+    BOOL matched = FALSE;
+
+    *found = FALSE;
+    if (!(arg = malloc( (end - src + 1) * sizeof(WCHAR) ))) return FALSE;
+    while (src < end)
+    {
+        SIZE_T arg_len;
+        const WCHAR *next = parse_argument( src, end, arg, &arg_len );
+
+        if ((compare_key && argument_keys_equal( arg, arg_len, wanted, wanted_len )) ||
+            (!compare_key && arg_len == wanted_len &&
+             !memcmp( arg, wanted, wanted_len * sizeof(WCHAR) )))
+        {
+            matched = TRUE;
+            break;
+        }
+        if (next <= src) break;
+        src = next;
+    }
+    free( arg );
+    *found = matched;
+    return TRUE;
+}
+
+static SIZE_T quoted_argument_length( const WCHAR *arg, SIZE_T length, BOOL *quoted )
+{
+    SIZE_T i, ret = length;
+
+    *quoted = !length;
+    for (i = 0; i < length; ++i)
+        if (arg[i] == ' ' || arg[i] == '\t' || arg[i] == '"') *quoted = TRUE;
+    if (!*quoted) return ret;
+
+    ret = 2;
+    for (i = 0; i < length;)
+    {
+        SIZE_T slashes = 0;
+        while (i < length && arg[i] == '\\')
+        {
+            ++slashes;
+            ++i;
+        }
+        if (i == length) ret += slashes * 2;
+        else if (arg[i] == '"')
+        {
+            ret += slashes * 2 + 2;
+            ++i;
+        }
+        else
+        {
+            ret += slashes + 1;
+            ++i;
+        }
+    }
+    return ret;
+}
+
+static WCHAR *write_quoted_argument( WCHAR *dst, const WCHAR *arg, SIZE_T length, BOOL quoted )
+{
+    SIZE_T i;
+
+    if (!quoted)
+    {
+        memcpy( dst, arg, length * sizeof(WCHAR) );
+        return dst + length;
+    }
+
+    *dst++ = '"';
+    for (i = 0; i < length;)
+    {
+        SIZE_T slashes = 0, j;
+        while (i < length && arg[i] == '\\')
+        {
+            ++slashes;
+            ++i;
+        }
+        if (i == length)
+        {
+            for (j = 0; j < slashes * 2; ++j) *dst++ = '\\';
+        }
+        else if (arg[i] == '"')
+        {
+            for (j = 0; j < slashes * 2 + 1; ++j) *dst++ = '\\';
+            *dst++ = '"';
+            ++i;
+        }
+        else
+        {
+            for (j = 0; j < slashes; ++j) *dst++ = '\\';
+            *dst++ = arg[i++];
+        }
+    }
+    *dst++ = '"';
+    return dst;
+}
+
+static BOOL append_argument( struct cyder_compat_result *result,
+                             const struct cyder_slice *slice )
+{
+    const UNICODE_STRING *current = &result->params.CommandLine;
+    SIZE_T old_len = current->Length / sizeof(WCHAR), arg_len, encoded_len, separator, total_len;
+    WCHAR *arg, *buffer, *dst;
+    BOOL quoted, found;
+
+    if (!(arg = slice_to_wstr( slice, &arg_len ))) return FALSE;
+    if (!command_line_has_argument( current, arg, arg_len, TRUE, &found ))
+    {
+        free( arg );
+        return FALSE;
+    }
+    if (found)
+    {
+        free( arg );
+        return TRUE;
+    }
+
+    encoded_len = quoted_argument_length( arg, arg_len, &quoted );
+    separator = !!old_len;
+    if (encoded_len + separator + 1 > USHRT_MAX / sizeof(WCHAR) ||
+        old_len > (USHRT_MAX / sizeof(WCHAR)) - encoded_len - separator - 1)
+    {
+        free( arg );
+        return FALSE;
+    }
+    total_len = old_len + separator + encoded_len;
+    if (!(buffer = malloc( (total_len + 1) * sizeof(WCHAR) )))
+    {
+        free( arg );
+        return FALSE;
+    }
+
+    memcpy( buffer, current->Buffer, old_len * sizeof(WCHAR) );
+    dst = buffer + old_len;
+    if (separator) *dst++ = ' ';
+    dst = write_quoted_argument( dst, arg, arg_len, quoted );
+    *dst = 0;
+    free( arg );
+    free( result->command_line );
+    result->command_line = buffer;
+    result->params.CommandLine.Buffer = buffer;
+    result->params.CommandLine.Length = total_len * sizeof(WCHAR);
+    result->params.CommandLine.MaximumLength = (total_len + 1) * sizeof(WCHAR);
+    result->modified = TRUE;
+    return TRUE;
+}
+
+static BOOL environment_entry_matches( const WCHAR *entry, SIZE_T length,
+                                       const WCHAR *name, SIZE_T name_len )
+{
+    SIZE_T i;
+
+    if (length <= name_len || entry[name_len] != '=') return FALSE;
+    for (i = 0; i < name_len; ++i)
+        if (towupper( entry[i] ) != towupper( name[i] )) return FALSE;
+    return TRUE;
+}
+
+static BOOL environment_size_chars( const RTL_USER_PROCESS_PARAMETERS *params,
+                                    SIZE_T *chars )
+{
+    const WCHAR *env = params->Environment;
+    SIZE_T limit, i = 0;
+
+    if (!env) return FALSE;
+    limit = params->EnvironmentSize / sizeof(WCHAR);
+    if (limit < 2 || limit > CYDER_CDB_MAX_ENV_CHARS) limit = CYDER_CDB_MAX_ENV_CHARS;
+    while (i + 1 < limit)
+    {
+        if (!env[i] && !env[i + 1])
+        {
+            *chars = i + 2;
+            return TRUE;
+        }
+        ++i;
+    }
+    return FALSE;
+}
+
+static BOOL set_environment_value( struct cyder_compat_result *result,
+                                   const struct cyder_slice *name_slice,
+                                   const struct cyder_slice *value_slice )
+{
+    const WCHAR *source = result->params.Environment, *entry;
+    SIZE_T source_chars, name_len, value_len = 0, kept = 0, entry_len;
+    WCHAR *name = NULL, *value = NULL, *buffer, *dst;
+
+    if (!(name = slice_to_wstr( name_slice, &name_len ))) return FALSE;
+    if (value_slice && !(value = slice_to_wstr( value_slice, &value_len )))
+    {
+        free( name );
+        return FALSE;
+    }
+    if (!environment_size_chars( &result->params, &source_chars ))
+    {
+        free( name );
+        free( value );
+        return FALSE;
+    }
+
+    entry = source;
+    while (*entry)
+    {
+        entry_len = wcslen( entry );
+        if (!environment_entry_matches( entry, entry_len, name, name_len ))
+            kept += entry_len + 1;
+        entry += entry_len + 1;
+    }
+    if (value_slice)
+    {
+        if (kept > CYDER_CDB_MAX_ENV_CHARS - name_len - value_len - 3)
+            goto failed;
+        kept += name_len + value_len + 2;
+    }
+    if (kept + 1 > CYDER_CDB_MAX_ENV_CHARS) goto failed;
+    if (!(buffer = malloc( (kept + 1) * sizeof(WCHAR) ))) goto failed;
+
+    dst = buffer;
+    entry = source;
+    while (*entry)
+    {
+        entry_len = wcslen( entry );
+        if (!environment_entry_matches( entry, entry_len, name, name_len ))
+        {
+            memcpy( dst, entry, (entry_len + 1) * sizeof(WCHAR) );
+            dst += entry_len + 1;
+        }
+        entry += entry_len + 1;
+    }
+    if (value_slice)
+    {
+        memcpy( dst, name, name_len * sizeof(WCHAR) );
+        dst += name_len;
+        *dst++ = '=';
+        memcpy( dst, value, value_len * sizeof(WCHAR) );
+        dst += value_len;
+        *dst++ = 0;
+    }
+    *dst++ = 0;
+
+    free( result->environment );
+    result->environment = buffer;
+    result->params.Environment = buffer;
+    result->params.EnvironmentSize = (dst - buffer) * sizeof(WCHAR);
+    result->modified = TRUE;
+    free( name );
+    free( value );
+    return TRUE;
+
+failed:
+    free( name );
+    free( value );
+    return FALSE;
+}
+
+static BOOL apply_environment_action( struct cyder_compat_result *result,
+                                      const struct cyder_slice *slice, BOOL set )
+{
+    struct cyder_slice name = *slice, value = {0};
+    const unsigned char *equals;
+
+    if (set)
+    {
+        if (!valid_set_env( slice )) return FALSE;
+        equals = memchr( slice->data, '=', slice->size );
+        name.size = equals - slice->data;
+        value.data = equals + 1;
+        value.size = slice->size - name.size - 1;
+        if (!value.size)
+        {
+            static const unsigned char empty[] = "";
+            value.data = empty;
+        }
+    }
+    else if (!valid_unset_env( slice )) return FALSE;
+
+    TRACE( "%s environment variable %s\n", set ? "setting" : "unsetting",
+           debugstr_an( (const char *)name.data, name.size ) );
+    if (set && !value.size)
+    {
+        WCHAR empty = 0;
+        SIZE_T name_len;
+        WCHAR *nameW = slice_to_wstr( &name, &name_len );
+        const WCHAR *source = result->params.Environment, *entry;
+        SIZE_T source_chars, kept = 0, entry_len;
+        WCHAR *buffer, *dst;
+
+        if (!nameW || !environment_size_chars( &result->params, &source_chars ))
+        {
+            free( nameW );
+            return FALSE;
+        }
+        entry = source;
+        while (*entry)
+        {
+            entry_len = wcslen( entry );
+            if (!environment_entry_matches( entry, entry_len, nameW, name_len ))
+                kept += entry_len + 1;
+            entry += entry_len + 1;
+        }
+        if (kept > CYDER_CDB_MAX_ENV_CHARS - name_len - 3 ||
+            !(buffer = malloc( (kept + name_len + 3) * sizeof(WCHAR) )))
+        {
+            free( nameW );
+            return FALSE;
+        }
+        dst = buffer;
+        entry = source;
+        while (*entry)
+        {
+            entry_len = wcslen( entry );
+            if (!environment_entry_matches( entry, entry_len, nameW, name_len ))
+            {
+                memcpy( dst, entry, (entry_len + 1) * sizeof(WCHAR) );
+                dst += entry_len + 1;
+            }
+            entry += entry_len + 1;
+        }
+        memcpy( dst, nameW, name_len * sizeof(WCHAR) );
+        dst += name_len;
+        *dst++ = '=';
+        *dst++ = empty;
+        *dst++ = 0;
+        free( result->environment );
+        result->environment = buffer;
+        result->params.Environment = buffer;
+        result->params.EnvironmentSize = (dst - buffer) * sizeof(WCHAR);
+        result->modified = TRUE;
+        free( nameW );
+        return TRUE;
+    }
+    return set_environment_value( result, &name, set ? &value : NULL );
+}
+
+static BOOL replace_first_argument( struct cyder_compat_result *result,
+                                    const WCHAR *replacement, SIZE_T replacement_len )
+{
+    const UNICODE_STRING *current = &result->params.CommandLine;
+    const WCHAR *end = current->Buffer + current->Length / sizeof(WCHAR), *tail;
+    WCHAR *scratch, *buffer, *dst;
+    SIZE_T ignored, quoted_len, tail_len, total;
+    BOOL quoted;
+
+    if (!(scratch = malloc( (end - current->Buffer + 1) * sizeof(WCHAR) ))) return FALSE;
+    tail = parse_argument( current->Buffer, end, scratch, &ignored );
+    free( scratch );
+    tail_len = end - tail;
+    quoted_len = quoted_argument_length( replacement, replacement_len, &quoted );
+    total = quoted_len + !!tail_len + tail_len;
+    if (total + 1 > USHRT_MAX / sizeof(WCHAR) ||
+        !(buffer = malloc( (total + 1) * sizeof(WCHAR) )))
+        return FALSE;
+    dst = write_quoted_argument( buffer, replacement, replacement_len, quoted );
+    if (tail_len)
+    {
+        *dst++ = ' ';
+        memcpy( dst, tail, tail_len * sizeof(WCHAR) );
+        dst += tail_len;
+    }
+    *dst = 0;
+    free( result->command_line );
+    result->command_line = buffer;
+    result->params.CommandLine.Buffer = buffer;
+    result->params.CommandLine.Length = total * sizeof(WCHAR);
+    result->params.CommandLine.MaximumLength = (total + 1) * sizeof(WCHAR);
+    result->modified = TRUE;
+    return TRUE;
+}
+
+static BOOL apply_executable_replacement( struct cyder_compat_result *result,
+                                          const UNICODE_STRING *image_path,
+                                          const struct cyder_slice *matched_suffix,
+                                          const struct cyder_slice *replacement )
+{
+    SIZE_T path_len = image_path->Length / sizeof(WCHAR);
+    SIZE_T source_len, replacement_len, prefix_len, total;
+    WCHAR *sourceW, *replacementW, *buffer;
+
+    if (!valid_replacement_suffix( replacement ) ||
+        !(sourceW = slice_to_wstr( matched_suffix, &source_len )))
+        return FALSE;
+    if (!(replacementW = slice_to_wstr( replacement, &replacement_len )))
+    {
+        free( sourceW );
+        return FALSE;
+    }
+    if (source_len > path_len)
+    {
+        free( sourceW );
+        free( replacementW );
+        return FALSE;
+    }
+    prefix_len = path_len - source_len;
+    total = prefix_len + replacement_len;
+    if (total + 1 > USHRT_MAX / sizeof(WCHAR) ||
+        !(buffer = malloc( (total + 1) * sizeof(WCHAR) )))
+    {
+        free( sourceW );
+        free( replacementW );
+        return FALSE;
+    }
+    memcpy( buffer, image_path->Buffer, prefix_len * sizeof(WCHAR) );
+    memcpy( buffer + prefix_len, replacementW, replacement_len * sizeof(WCHAR) );
+    buffer[total] = 0;
+    free( sourceW );
+    free( replacementW );
+    if (!replace_first_argument( result, buffer, total ))
+    {
+        free( buffer );
+        return FALSE;
+    }
+    free( result->image_path );
+    result->image_path = buffer;
+    result->params.ImagePathName.Buffer = buffer;
+    result->params.ImagePathName.Length = total * sizeof(WCHAR);
+    result->params.ImagePathName.MaximumLength = (total + 1) * sizeof(WCHAR);
+    TRACE( "replacing executable with %s\n", debugstr_w(buffer) );
+    result->modified = TRUE;
+    return TRUE;
+}
+
+static BOOL apply_dll_override( const struct cyder_slice *slice )
+{
+    SIZE_T length;
+    WCHAR *entry;
+
+    if (!valid_dll_override( slice ) || !(entry = slice_to_wstr( slice, &length )))
+        return FALSE;
+    TRACE( "adding process-local DLL override %s\n",
+           debugstr_an( (const char *)slice->data, slice->size ) );
+    add_load_order_override( entry );
+    free( entry );
+    return TRUE;
+}
+
+static const char *graphics_backend_root(void)
+{
+    const char *root = getenv( "CYDER_GRAPHICS_BACKENDS_ROOT" );
+
+    return root && root[0] == '/' ? root : NULL;
+}
+
+static const char *graphics_machine_dir(void)
+{
+    if (main_image_info.Machine == IMAGE_FILE_MACHINE_I386) return "i386-windows";
+    if (main_image_info.Machine == IMAGE_FILE_MACHINE_AMD64) return "x86_64-windows";
+    if (main_image_info.Machine == IMAGE_FILE_MACHINE_ARM64) return "aarch64-windows";
+    return NULL;
+}
+
+static BOOL backend_has_module( const char *path, const char *machine, const char *module )
+{
+    char file[PATH_MAX];
+
+    if (snprintf( file, sizeof(file), "%s/%s/%s.dll", path, machine, module ) >= sizeof(file))
+        return FALSE;
+    return !access( file, R_OK );
+}
+
+static BOOL add_backend_override( struct cyder_applied_state *applied,
+                                  const char *module, const char *order )
+{
+    struct cyder_slice key = {(const unsigned char *)module, strlen( module )};
+    size_t order_len = strlen( order );
+    size_t length = key.size + order_len + 2;
+    WCHAR *entry;
+    int status;
+
+    status = slice_key_status( applied->dll_names, &applied->dll_name_count,
+                               key.data, key.size );
+    if (status < 0) return FALSE;
+    if (status) return TRUE;
+    if (!(entry = calloc( length, sizeof(*entry) ))) return FALSE;
+    ntdll_umbstowcs( module, key.size, entry, key.size );
+    entry[key.size] = '=';
+    ntdll_umbstowcs( order, order_len, entry + key.size + 1, order_len );
+    add_load_order_override( entry );
+    free( entry );
+    return TRUE;
+}
+
+static BOOL apply_graphics_backend( const struct cyder_slice *slice,
+                                    struct cyder_applied_state *applied )
+{
+    static const char *modules[] =
+    {
+        "ddraw", "d3d8", "d3d9", "d3d10", "d3d10_1", "d3d10core",
+        "d3d11", "d3d12", "dxgi", "winemetal"
+    };
+    char backend[16], path[PATH_MAX], shared[PATH_MAX], support[PATH_MAX];
+    const char *root, *machine, *active;
+    BOOL external = FALSE, found = FALSE;
+    unsigned int i;
+
+    if (slice->size >= sizeof(backend)) return FALSE;
+    memcpy( backend, slice->data, slice->size );
+    backend[slice->size] = 0;
+    active = backend;
+
+    if (!strcmp( backend, "default" ) || !strcmp( backend, "wined3d" ))
+    {
+        active = "wined3d";
+        for (i = 0; i < ARRAY_SIZE(modules) - 1; ++i)
+            if (!add_backend_override( applied, modules[i], "b" )) return FALSE;
+    }
+    else
+    {
+        root = graphics_backend_root();
+        machine = graphics_machine_dir();
+        if (!root || !machine) goto unavailable;
+        if (!strcmp( backend, "d3dmetal" ))
+        {
+            if (snprintf( path, sizeof(path), "%s/lib64/apple_gptk/wine", root ) >= sizeof(path) ||
+                snprintf( shared, sizeof(shared),
+                          "%s/lib64/apple_gptk/external/libd3dshared.dylib", root ) >= sizeof(shared) ||
+                access( shared, R_OK ))
+                goto unavailable;
+            if (snprintf( support, sizeof(support),
+                          "%s/lib64/apple_gptk/external/D3DMetal.framework/Versions/A/D3DMetal",
+                          root ) >= sizeof(support) || access( support, R_OK ))
+                goto unavailable;
+            external = TRUE;
+        }
+        else if (snprintf( path, sizeof(path), "%s/lib/%s", root, backend ) >= sizeof(path))
+            goto unavailable;
+        if (!strcmp( backend, "dxmt" ))
+        {
+            if (snprintf( support, sizeof(support),
+                          "%s/x86_64-unix/winemetal.so", path ) >= sizeof(support) ||
+                access( support, R_OK ))
+                goto unavailable;
+        }
+        else if (!strcmp( backend, "dxvk" ))
+        {
+            if (snprintf( support, sizeof(support),
+                          "%s/lib/wine/x86_64-unix/libMoltenVK.dylib", root ) >= sizeof(support))
+                goto unavailable;
+            if (access( support, R_OK ))
+            {
+                if (snprintf( support, sizeof(support),
+                              "%s/lib64/libMoltenVK.dylib", root ) >= sizeof(support) ||
+                    access( support, R_OK ))
+                    goto unavailable;
+            }
+        }
+
+        for (i = 0; i < ARRAY_SIZE(modules); ++i)
+        {
+            if (!backend_has_module( path, machine, modules[i] )) continue;
+            found = TRUE;
+            if (!add_backend_override( applied, modules[i],
+                                       !strcmp( backend, "dxvk" ) ? "n,b" : "b" ))
+                return FALSE;
+        }
+        if (!found) goto unavailable;
+        {
+            char *retained_path = strdup( path );
+            if (!retained_path) return FALSE;
+            prepend_dll_path( retained_path );
+        }
+        if (external) setenv( "CX_APPLEGPTK_LIBD3DSHARED_PATH", shared, 1 );
+    }
+    setenv( "CX_ACTIVE_GRAPHICS_BACKEND", active, 1 );
+    TRACE( "activated graphics backend %s\n", debugstr_a(active) );
+    return TRUE;
+
+unavailable:
+    WARN( "graphics backend %s is unavailable; falling back to wined3d\n",
+          debugstr_a(backend) );
+    for (i = 0; i < ARRAY_SIZE(modules) - 1; ++i)
+        if (!add_backend_override( applied, modules[i], "b" )) return FALSE;
+    setenv( "CX_ACTIVE_GRAPHICS_BACKEND", "wined3d", 1 );
+    return TRUE;
+}
+
+static unsigned int rule_action_count( const struct cyder_rule *rule )
+{
+    return rule->action_count + rule->dll_override_count + rule->set_env_count +
+           rule->unset_env_count + rule->have_graphics_backend +
+           rule->have_wined3d_renderer + rule->have_replacement;
+}
+
+static BOOL finish_rule( const struct cyder_rule *rule, const UNICODE_STRING *image_path,
+                         struct cyder_compat_result *result, BOOL apply_dll_overrides,
+    struct cyder_applied_state *applied )
+{
+    unsigned int i;
+    int key_status;
+    const struct cyder_slice *matched_suffix = NULL;
+    BOOL path_match = FALSE;
+
+    if (rule->invalid || !rule->have_id || !rule->have_priority || !rule->have_enabled ||
+        !rule->path_count || !rule_action_count( rule ) || !rule->enabled)
+        return TRUE;
+    if (rule->have_replacement && rule_action_count( rule ) != 1) return TRUE;
+    if (rule->have_wined3d_renderer && rule->have_graphics_backend &&
+        (rule->graphics_backend.size != 7 ||
+         (memcmp( rule->graphics_backend.data, "default", 7 ) &&
+          memcmp( rule->graphics_backend.data, "wined3d", 7 ))))
+        return TRUE;
+
+    for (i = 0; i < rule->path_count; ++i)
+    {
+        BOOL matched;
+        if (!path_has_suffix( image_path, &rule->paths[i], &matched )) return FALSE;
+        if (matched)
+        {
+            path_match = TRUE;
+            if (!matched_suffix || rule->paths[i].size > matched_suffix->size)
+                matched_suffix = &rule->paths[i];
+        }
+    }
+    if (!path_match) return TRUE;
+
+    for (i = 0; i < rule->forbidden_count; ++i)
+    {
+        SIZE_T length;
+        WCHAR *arg = slice_to_wstr( &rule->forbidden[i], &length );
+        BOOL found;
+
+        if (!arg) return FALSE;
+        if (!command_line_has_argument( &result->params.CommandLine, arg, length, FALSE, &found ))
+        {
+            free( arg );
+            return FALSE;
+        }
+        free( arg );
+        if (found) return TRUE;
+    }
+
+    TRACE( "matched rule %s priority %d\n",
+           debugstr_an( (const char *)rule->id.data, rule->id.size ), rule->priority );
+    if (apply_dll_overrides)
+    {
+        for (i = 0; i < rule->dll_override_count; ++i)
+        {
+            const struct cyder_slice *action = &rule->dll_overrides[i];
+            const unsigned char *equals = memchr( action->data, '=', action->size );
+            if (!equals) return FALSE;
+            key_status = slice_key_status( applied->dll_names, &applied->dll_name_count,
+                                           action->data, equals - action->data );
+            if (key_status < 0) return FALSE;
+            if (key_status) continue;
+            if (!apply_dll_override( action )) return FALSE;
+        }
+        if (rule->have_graphics_backend && !applied->graphics_backend)
+        {
+            if (!apply_graphics_backend( &rule->graphics_backend, applied ))
+                return FALSE;
+            applied->graphics_backend = TRUE;
+        }
+    }
+    else
+    {
+        for (i = 0; i < rule->action_count; ++i)
+        {
+            TRACE( "appending argument %s\n",
+                   debugstr_an( (const char *)rule->actions[i].data, rule->actions[i].size ) );
+            if (!append_argument( result, &rule->actions[i] )) return FALSE;
+        }
+        for (i = 0; i < rule->set_env_count; ++i)
+        {
+            const struct cyder_slice *action = &rule->set_env[i];
+            const unsigned char *equals = memchr( action->data, '=', action->size );
+            if (!equals) return FALSE;
+            key_status = slice_key_status( applied->env_names, &applied->env_name_count,
+                                           action->data, equals - action->data );
+            if (key_status < 0) return FALSE;
+            if (key_status) continue;
+            if (!apply_environment_action( result, action, TRUE )) return FALSE;
+        }
+        for (i = 0; i < rule->unset_env_count; ++i)
+        {
+            const struct cyder_slice *action = &rule->unset_env[i];
+            key_status = slice_key_status( applied->env_names, &applied->env_name_count,
+                                           action->data, action->size );
+            if (key_status < 0) return FALSE;
+            if (key_status) continue;
+            if (!apply_environment_action( result, action, FALSE )) return FALSE;
+        }
+        if (rule->have_graphics_backend && !applied->graphics_backend)
+        {
+            static const unsigned char name_data[] = "CYDER_GRAPHICS_BACKEND";
+            struct cyder_slice name = {name_data, sizeof(name_data) - 1};
+
+            TRACE( "selecting graphics backend %s\n",
+                   debugstr_an( (const char *)rule->graphics_backend.data,
+                                rule->graphics_backend.size ) );
+            if (!set_environment_value( result, &name, &rule->graphics_backend ))
+                return FALSE;
+            applied->graphics_backend = TRUE;
+        }
+        if (rule->have_wined3d_renderer && !applied->wined3d_renderer)
+        {
+            static const unsigned char name_data[] = "CYDER_WINED3D_RENDERER";
+            struct cyder_slice name = {name_data, sizeof(name_data) - 1};
+
+            TRACE( "selecting WineD3D renderer %s\n",
+                   debugstr_an( (const char *)rule->wined3d_renderer.data,
+                                rule->wined3d_renderer.size ) );
+            if (!set_environment_value( result, &name, &rule->wined3d_renderer ))
+                return FALSE;
+            applied->wined3d_renderer = TRUE;
+        }
+        if (rule->have_replacement && !applied->replacement)
+        {
+            if (!apply_executable_replacement( result, image_path, matched_suffix,
+                                               &rule->replacement ))
+                return FALSE;
+            applied->replacement = TRUE;
+        }
+    }
+    return TRUE;
+}
+
+static BOOL parse_and_apply_rules( const struct cyder_cdb *db, const UNICODE_STRING *image_path,
+                                   struct cyder_compat_result *result,
+                                   BOOL apply_dll_overrides )
+{
+    size_t offset = CYDER_CDB_HEADER_SIZE;
+    struct cyder_rule rule;
+    struct cyder_applied_state applied;
+    uint32_t i;
+    BOOL in_rule = FALSE;
+    BOOL have_last_priority = FALSE;
+    int32_t last_priority = INT32_MAX;
+
+    memset( &rule, 0, sizeof(rule) );
+    memset( &applied, 0, sizeof(applied) );
+    for (i = 0; i < db->record_count; ++i)
+    {
+        uint16_t type = read_u16( db->data + offset );
+        uint16_t flags = read_u16( db->data + offset + 2 );
+        uint32_t size = read_u32( db->data + offset + 4 );
+        struct cyder_slice slice;
+
+        offset += 8;
+        slice.data = db->data + offset;
+        slice.size = size;
+        offset += size;
+
+        if (type == CYDER_CDB_RULE_BEGIN)
+        {
+            memset( &rule, 0, sizeof(rule) );
+            in_rule = TRUE;
+            if (flags != CYDER_CDB_RECORD_REQUIRED) rule.invalid = TRUE;
+            continue;
+        }
+        if (type == CYDER_CDB_RULE_END)
+        {
+            if (flags != CYDER_CDB_RECORD_REQUIRED) rule.invalid = TRUE;
+            if (!rule.invalid && rule.have_priority)
+            {
+                if (have_last_priority && rule.priority > last_priority) return FALSE;
+                last_priority = rule.priority;
+                have_last_priority = TRUE;
+            }
+            if (!finish_rule( &rule, image_path, result, apply_dll_overrides, &applied ))
+                return FALSE;
+            in_rule = FALSE;
+            continue;
+        }
+
+        if (flags & ~CYDER_CDB_RECORD_REQUIRED) rule.invalid = TRUE;
+        switch (type)
+        {
+        case CYDER_CDB_RULE_ID:
+            if (flags != CYDER_CDB_RECORD_REQUIRED || rule.have_id || !valid_utf8_string( &slice ))
+                rule.invalid = TRUE;
+            else
+            {
+                rule.id = slice;
+                rule.have_id = TRUE;
+            }
+            break;
+        case CYDER_CDB_PRIORITY:
+            if (flags != CYDER_CDB_RECORD_REQUIRED || rule.have_priority || size != 4)
+                rule.invalid = TRUE;
+            else
+            {
+                rule.priority = (int32_t)read_u32( slice.data );
+                rule.have_priority = TRUE;
+            }
+            break;
+        case CYDER_CDB_ENABLED:
+            if (flags != CYDER_CDB_RECORD_REQUIRED || rule.have_enabled ||
+                size != 1 || slice.data[0] > 1)
+                rule.invalid = TRUE;
+            else
+            {
+                rule.enabled = slice.data[0];
+                rule.have_enabled = TRUE;
+            }
+            break;
+        case CYDER_CDB_MATCH_PATH_SUFFIX:
+            if (flags != CYDER_CDB_RECORD_REQUIRED ||
+                rule.path_count + rule.forbidden_count == CYDER_CDB_MAX_RULE_MATCHES ||
+                !valid_path_suffix( &slice ))
+                rule.invalid = TRUE;
+            else rule.paths[rule.path_count++] = slice;
+            break;
+        case CYDER_CDB_MATCH_FORBIDDEN_ARG:
+            if (flags != CYDER_CDB_RECORD_REQUIRED ||
+                rule.path_count + rule.forbidden_count == CYDER_CDB_MAX_RULE_MATCHES ||
+                !valid_utf8_string( &slice ))
+                rule.invalid = TRUE;
+            else rule.forbidden[rule.forbidden_count++] = slice;
+            break;
+        case CYDER_CDB_ACTION_APPEND_ARG:
+            if (flags != CYDER_CDB_RECORD_REQUIRED ||
+                rule_action_count( &rule ) == CYDER_CDB_MAX_RULE_ACTIONS ||
+                !valid_utf8_string( &slice ))
+                rule.invalid = TRUE;
+            else rule.actions[rule.action_count++] = slice;
+            break;
+        case CYDER_CDB_ACTION_DLL_OVERRIDE:
+            if (flags != CYDER_CDB_RECORD_REQUIRED ||
+                rule_action_count( &rule ) == CYDER_CDB_MAX_RULE_ACTIONS ||
+                !valid_dll_override( &slice ))
+                rule.invalid = TRUE;
+            else rule.dll_overrides[rule.dll_override_count++] = slice;
+            break;
+        case CYDER_CDB_ACTION_SET_ENV:
+            if (flags != CYDER_CDB_RECORD_REQUIRED ||
+                rule_action_count( &rule ) == CYDER_CDB_MAX_RULE_ACTIONS ||
+                !valid_set_env( &slice ))
+                rule.invalid = TRUE;
+            else rule.set_env[rule.set_env_count++] = slice;
+            break;
+        case CYDER_CDB_ACTION_UNSET_ENV:
+            if (flags != CYDER_CDB_RECORD_REQUIRED ||
+                rule_action_count( &rule ) == CYDER_CDB_MAX_RULE_ACTIONS ||
+                !valid_unset_env( &slice ))
+                rule.invalid = TRUE;
+            else rule.unset_env[rule.unset_env_count++] = slice;
+            break;
+        case CYDER_CDB_ACTION_GRAPHICS_BACKEND:
+            if (flags != CYDER_CDB_RECORD_REQUIRED || rule.have_graphics_backend ||
+                rule_action_count( &rule ) == CYDER_CDB_MAX_RULE_ACTIONS ||
+                !valid_graphics_backend( &slice ))
+                rule.invalid = TRUE;
+            else
+            {
+                rule.graphics_backend = slice;
+                rule.have_graphics_backend = TRUE;
+            }
+            break;
+        case CYDER_CDB_ACTION_WINED3D_RENDERER:
+            if (flags != CYDER_CDB_RECORD_REQUIRED || rule.have_wined3d_renderer ||
+                rule_action_count( &rule ) == CYDER_CDB_MAX_RULE_ACTIONS ||
+                !valid_wined3d_renderer( &slice ))
+                rule.invalid = TRUE;
+            else
+            {
+                rule.wined3d_renderer = slice;
+                rule.have_wined3d_renderer = TRUE;
+            }
+            break;
+        case CYDER_CDB_ACTION_REPLACE_EXECUTABLE:
+            if (flags != CYDER_CDB_RECORD_REQUIRED || rule.have_replacement ||
+                rule_action_count( &rule ) == CYDER_CDB_MAX_RULE_ACTIONS ||
+                !valid_replacement_suffix( &slice ))
+                rule.invalid = TRUE;
+            else
+            {
+                rule.replacement = slice;
+                rule.have_replacement = TRUE;
+            }
+            break;
+        default:
+            if (flags & CYDER_CDB_RECORD_REQUIRED) rule.invalid = TRUE;
+            break;
+        }
+    }
+    return !in_rule;
+}
+
+BOOL cyder_compat_apply_process_rules( UNICODE_STRING *image_path,
+                                       const RTL_USER_PROCESS_PARAMETERS *params,
+                                       struct cyder_compat_result *result )
+{
+    const char *disabled = getenv( "CYDER_COMPATDB" );
+    const char *path = getenv( "CYDER_COMPATDB_PATH" );
+    struct cyder_cdb db;
+
+    memset( result, 0, sizeof(*result) );
+    if (disabled && !strcmp( disabled, "0" )) return FALSE;
+    if (!image_path || !image_path->Buffer || !params || !params->CommandLine.Buffer) return FALSE;
+    if (!load_cdb( path, &db )) return FALSE;
+    if (!validate_cdb_structure( &db ))
+    {
+        WARN( "ignoring structurally invalid database %s\n", debugstr_a(path) );
+        free_cdb( &db );
+        return FALSE;
+    }
+    if (!validate_unique_rule_ids( &db ))
+    {
+        free_cdb( &db );
+        return FALSE;
+    }
+
+    result->params = *params;
+    TRACE( "loaded CDB v1 with %u rules from %s\n", db.rule_count, debugstr_a(path) );
+    if (!parse_and_apply_rules( &db, image_path, result, FALSE ))
+    {
+        WARN( "ignoring compatibility changes after runtime failure\n" );
+        cyder_compat_cleanup_process_rules( result );
+        free_cdb( &db );
+        return FALSE;
+    }
+    free_cdb( &db );
+    if (result->image_path)
+    {
+        image_path->Buffer = result->image_path;
+        image_path->Length = result->params.ImagePathName.Length;
+        image_path->MaximumLength = result->params.ImagePathName.MaximumLength;
+    }
+    return result->modified;
+}
+
+void cyder_compat_apply_current_process_dll_rules( const UNICODE_STRING *image_path,
+                                                    const UNICODE_STRING *command_line )
+{
+    const char *disabled = getenv( "CYDER_COMPATDB" );
+    const char *path = getenv( "CYDER_COMPATDB_PATH" );
+    struct cyder_compat_result result;
+    struct cyder_cdb db;
+
+    if (disabled && !strcmp( disabled, "0" )) return;
+    if (!image_path || !image_path->Buffer || !command_line || !command_line->Buffer) return;
+    if (!load_cdb( path, &db )) return;
+    if (!validate_cdb_structure( &db ) || !validate_unique_rule_ids( &db ))
+    {
+        WARN( "ignoring structurally invalid database %s\n", debugstr_a(path) );
+        free_cdb( &db );
+        return;
+    }
+
+    memset( &result, 0, sizeof(result) );
+    result.params.CommandLine = *command_line;
+    TRACE( "loading process-local DLL rules from CDB v1 with %u rules\n", db.rule_count );
+    if (!parse_and_apply_rules( &db, image_path, &result, TRUE ))
+        WARN( "ignoring remaining process-local DLL rules after runtime failure\n" );
+    free_cdb( &db );
+}
+
+void cyder_compat_cleanup_process_rules( struct cyder_compat_result *result )
+{
+    free( result->command_line );
+    free( result->environment );
+    free( result->image_path );
+    memset( result, 0, sizeof(*result) );
+}
