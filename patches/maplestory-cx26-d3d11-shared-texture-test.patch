+    if (ID3D11View_QueryInterface(view, &IID_ID3D11UnorderedAccessView, (void **)&unknown) == S_OK)
+    {
+        struct d3d11_unordered_access_view *view_impl =
+                unsafe_impl_from_ID3D11UnorderedAccessView((ID3D11UnorderedAccessView *)unknown);
+
+        /* wined3d's public UAV clear currently clears the complete view. This
+         * matches ClearView when no rectangles are supplied and is preferable
+         * to Wine's former no-op for applications that use ClearView for their
+         * primary render path. Partial UAV rectangles can be added to wined3d
+         * independently without changing this D3D11 entry point again. */
+        if (rect_count)
+            FIXME("Partial unordered-access ClearView is not implemented; clearing the complete view.\n");
+        wined3d_device_context_clear_uav_float(context->wined3d_context,
+                view_impl->wined3d_view, (const struct wined3d_vec4 *)color);
+    }
+    else if (ID3D11View_QueryInterface(view, &IID_ID3D11RenderTargetView, (void **)&unknown) == S_OK)
+    {
+        struct d3d_rendertarget_view *view_impl =
+                unsafe_impl_from_ID3D11RenderTargetView((ID3D11RenderTargetView *)unknown);
+
+        if (!rect_count)
+        {
+            wined3d_device_context_clear_rendertarget_view(context->wined3d_context,
+                    view_impl->wined3d_view, NULL, WINED3DCLEAR_TARGET,
+                    (const struct wined3d_color *)color, 0.0f, 0);
+        }
+        else
+        {
+            for (i = 0; i < rect_count; ++i)
+                wined3d_device_context_clear_rendertarget_view(context->wined3d_context,
+                        view_impl->wined3d_view, &rects[i], WINED3DCLEAR_TARGET,
+                        (const struct wined3d_color *)color, 0.0f, 0);
+        }
+    }
+    else if (ID3D11View_QueryInterface(view, &IID_ID3D11DepthStencilView, (void **)&unknown) == S_OK)
+    {
+        struct d3d_depthstencil_view *view_impl =
+                unsafe_impl_from_ID3D11DepthStencilView((ID3D11DepthStencilView *)unknown);
+
+        if (!rect_count)
+        {
+            wined3d_device_context_clear_rendertarget_view(context->wined3d_context,
+                    view_impl->wined3d_view, NULL, WINED3DCLEAR_ZBUFFER, NULL, color[0], 0);
+        }
+        else
+        {
+            for (i = 0; i < rect_count; ++i)
+                wined3d_device_context_clear_rendertarget_view(context->wined3d_context,
+                        view_impl->wined3d_view, &rects[i], WINED3DCLEAR_ZBUFFER, NULL, color[0], 0);
+        }
+    }
+    else
+    {
+        FIXME("Unimplemented view type.\n");
+        return;
+    }
+
+    IUnknown_Release(unknown);
