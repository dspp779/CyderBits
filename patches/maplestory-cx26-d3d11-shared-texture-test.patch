 {
-    FIXME("iface %p, view %p, color %p, rect %p, num_rects %u stub!\n", iface, view, color, rect, num_rects);
+    struct d3d11_device_context *context = impl_from_ID3D11DeviceContext4(iface);
+    IUnknown *unknown;
