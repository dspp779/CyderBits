+                            TRACE("Replacing temporary module name %s with original name %s.\n",
+                                    debugstr_w(name), debugstr_w(original_name));
+                            name = original_name;
+                        }
+                    }
+                    CloseHandle( sidecar_file );
+                }
+                HeapFree( GetProcessHeap(), 0, sidecar );
+            }
+        }
+    }
