+static uint32_t float_to_uint_clamped(float f, uint32_t max)
+{
+    if (isnan(f) || f < 0)
+        return 0;
+    if (f >= max)
+        return max;
+    return f;
+}
+
+static uint32_t float_to_int_clamped(float f, int32_t min, int32_t max)
+{
+    if (isnan(f))
+        return 0;
+    if (f <= min)
+        return min;
+    if (f >= max)
+        return max;
+    return f;
+}
+
+static uint32_t wined3d_format_convert_float_to_uint(const struct wined3d_format *format, float f)
+{
+    switch (format->id)
+    {
+        case WINED3DFMT_R32G32B32A32_UINT:
+        case WINED3DFMT_R32G32B32_UINT:
+        case WINED3DFMT_R32G32_UINT:
+        case WINED3DFMT_R32_UINT:
+            return float_to_uint_clamped(f, UINT_MAX);
+
+        case WINED3DFMT_R16G16B16A16_UINT:
+        case WINED3DFMT_R16G16_UINT:
+        case WINED3DFMT_R16_UINT:
+            return float_to_uint_clamped(f, USHRT_MAX);
+
+        case WINED3DFMT_R8G8B8A8_UINT:
+        case WINED3DFMT_R8G8_UINT:
+        case WINED3DFMT_R8_UINT:
+            return float_to_uint_clamped(f, UCHAR_MAX);
+
+        case WINED3DFMT_R32G32B32A32_SINT:
+        case WINED3DFMT_R32G32B32_SINT:
+        case WINED3DFMT_R32G32_SINT:
+        case WINED3DFMT_R32_SINT:
+            return float_to_int_clamped(f, INT_MIN, INT_MAX);
+
+        case WINED3DFMT_R16G16B16A16_SINT:
+        case WINED3DFMT_R16G16_SINT:
+        case WINED3DFMT_R16_SINT:
+            return float_to_int_clamped(f, SHRT_MIN, SHRT_MAX);
+
+        case WINED3DFMT_R8G8B8A8_SINT:
+        case WINED3DFMT_R8G8_SINT:
+        case WINED3DFMT_R8_SINT:
+            return float_to_int_clamped(f, SCHAR_MIN, SCHAR_MAX);
+
+        default:
+            FIXME("Unhandled format %s.\n", debug_d3dformat(format->id));
+            return 0;
+    }
+}
+
+void CDECL wined3d_device_context_clear_uav(struct wined3d_device_context *context,
+        struct wined3d_unordered_access_view *view, const struct wined3d_vec4 *clear_value,
+        const RECT *rects, unsigned int rect_count)
+{
+    const struct wined3d_format *format = view->format;
+    RECT full_rect;
+
+    TRACE("context %p, view %p, clear_value %s.\n",
+            context, view, debug_vec4(clear_value));
+    for (unsigned int i = 0; i < rect_count; ++i)
+        TRACE("Clear rect %s.\n", wine_dbgstr_rect(&rects[i]));
+
+    if (!rect_count)
+    {
+        if (view->resource->type == WINED3D_RTYPE_BUFFER)
+            SetRect(&full_rect, 0, 0, view->desc.u.buffer.count, 1);
+        else
+            SetRect(&full_rect, 0, 0, view->resource->width, view->resource->height);
+        rect_count = 1;
+        rects = &full_rect;
+    }
+
+    if (format->attrs & (WINED3D_FORMAT_ATTR_FLOAT | WINED3D_FORMAT_ATTR_NORMALISED))
+    {
+        wined3d_device_context_lock(context);
+        wined3d_device_context_emit_clear_uav(context, view,
+                (const struct wined3d_uvec4 *)clear_value, rects, rect_count, true);
+        wined3d_device_context_unlock(context);
+    }
+    else
+    {
+        struct wined3d_uvec4 uint_value;
+
+        uint_value.x = wined3d_format_convert_float_to_uint(format, clear_value->x);
+        uint_value.y = wined3d_format_convert_float_to_uint(format, clear_value->y);
+        uint_value.z = wined3d_format_convert_float_to_uint(format, clear_value->z);
+        uint_value.w = wined3d_format_convert_float_to_uint(format, clear_value->w);
+
+        wined3d_device_context_lock(context);
+        wined3d_device_context_emit_clear_uav(context, view, &uint_value, rects, rect_count, false);
+        wined3d_device_context_unlock(context);
+    }
+}
