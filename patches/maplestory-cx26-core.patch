+#if 0
+#pragma makedep unix
+#endif
+
+#include <gst/audio/audio-info.h>
+#include <gst/base/gstbaseparse.h>
+
+typedef struct
+{
+    GstBaseParse baseparse;
+
+    GstAudioInfo audio_info;
+} RawAudioParse;
+
+typedef struct
+{
+    GstBaseParseClass parent_class;
+} RawAudioParseClass;
+
+G_DEFINE_TYPE(RawAudioParse, raw_audio_parse, GST_TYPE_BASE_PARSE);
+#define RAW_AUDIO_PARSE_TYPE (raw_audio_parse_get_type())
+#define RAW_AUDIO_PARSE(obj) (G_TYPE_CHECK_INSTANCE_CAST((obj), RAW_AUDIO_PARSE_TYPE, RawAudioParse))
+#define parent_class raw_audio_parse_parent_class
+
+gboolean gst_element_register_rawaudioparse(GstPlugin *plugin)
+{
+    return gst_element_register(plugin, "rawaudioparse", GST_RANK_NONE, RAW_AUDIO_PARSE_TYPE);
+}
+
+static GstStaticPadTemplate raw_audio_parse_sink_template = GST_STATIC_PAD_TEMPLATE("sink",
+        GST_PAD_SINK, GST_PAD_ALWAYS,
+        GST_STATIC_CAPS("audio/x-raw"));
+
+static GstStaticPadTemplate raw_audio_parse_src_template = GST_STATIC_PAD_TEMPLATE("src",
+        GST_PAD_SRC, GST_PAD_ALWAYS,
+        GST_STATIC_CAPS("audio/x-raw"));
+
+static GstCaps *raw_audio_parse_get_sink_caps (GstBaseParse *parse, GstCaps *filter);
+static gboolean raw_audio_parse_set_sink_caps (GstBaseParse *parse, GstCaps *caps);
+static GstFlowReturn raw_audio_parse_handle_frame (GstBaseParse *parse, GstBaseParseFrame *frame, gint *skipsize);
+
+static void raw_audio_parse_class_init (RawAudioParseClass *klass)
+{
+    GstBaseParseClass *parse_class = GST_BASE_PARSE_CLASS (klass);
+    GstElementClass *element_class = GST_ELEMENT_CLASS (klass);
+
+    parse_class->get_sink_caps = GST_DEBUG_FUNCPTR (raw_audio_parse_get_sink_caps);
+    parse_class->set_sink_caps = GST_DEBUG_FUNCPTR (raw_audio_parse_set_sink_caps);
+    parse_class->handle_frame = GST_DEBUG_FUNCPTR (raw_audio_parse_handle_frame);
+
+    gst_element_class_add_static_pad_template (element_class, &raw_audio_parse_sink_template);
+    gst_element_class_add_static_pad_template (element_class, &raw_audio_parse_src_template);
+
+    gst_element_class_set_static_metadata (element_class,
+      "Proton Raw Audio Parser", "Codec/Parser/Audio",
+      "Proton Audio Parser", "Brendan McGrath <bmcgrath@codeweavers.com>");
+}
+
+static void raw_audio_parse_init (RawAudioParse *raw_audio_parse)
+{
+}
+
+static GstCaps *raw_audio_parse_get_sink_caps (GstBaseParse *parse, GstCaps *filter)
+{
+    return gst_pad_peer_query_caps(GST_BASE_PARSE_SRC_PAD(parse), filter);
+}
+
+static gboolean raw_audio_parse_set_sink_caps (GstBaseParse *parse, GstCaps *caps)
+{
+    RawAudioParse *raw_audio_parse = RAW_AUDIO_PARSE(parse);
+    guint frame_size;
+    gboolean ret;
+    GstPad *pad;
+
+    pad = GST_BASE_PARSE_SRC_PAD(parse);
+    ret = gst_pad_set_caps(pad, caps);
+
+    GST_DEBUG_OBJECT(pad, "%sset caps to %"GST_PTR_FORMAT, ret ? "" : "failed to ", caps);
+
+    if (ret && (ret = gst_audio_info_from_caps(&raw_audio_parse->audio_info, caps)))
+    {
+        frame_size = raw_audio_parse->audio_info.rate * raw_audio_parse->audio_info.bpf * 0.3;
+        GST_DEBUG("Using frame size %d", frame_size);
+        gst_base_parse_set_min_frame_size(parse, frame_size);
+    }
+    else
+    {
+        GST_WARNING("Operating in passthrough mode");
+        gst_base_parse_set_passthrough(parse, TRUE);
+    }
+
+    return ret;
+}
+
+static GstFlowReturn raw_audio_parse_handle_frame (GstBaseParse *parse, GstBaseParseFrame *frame, gint *skipsize)
+{
+    RawAudioParse *raw_audio_parse = RAW_AUDIO_PARSE(parse);
+    gsize size;
+
+    size = gst_buffer_get_size(frame->buffer);
+    GST_BUFFER_DURATION(frame->buffer) = size * GST_SECOND / raw_audio_parse->audio_info.bpf / raw_audio_parse->audio_info.rate;
+    gst_base_parse_finish_frame(parse, frame, size);
+    return GST_FLOW_OK;
+}
